{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "change-model.schema.json",
  "title": "change-model.json (Phase B output)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "head",
    "base",
    "title",
    "summary",
    "risks",
    "scannedCategories",
    "tests"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "head": {
      "type": "string"
    },
    "base": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headline",
        "why",
        "perFile"
      ],
      "properties": {
        "headline": {
          "type": "string"
        },
        "why": {
          "type": "string"
        },
        "perFile": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "note"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "severity",
          "title",
          "rationale",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R[0-9]+$"
          },
          "category": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "line",
                "deleted"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "deleted": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "scannedCategories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "happyPath",
        "edgeCases"
      ],
      "properties": {
        "happyPath": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "scenario",
              "input",
              "expected",
              "level",
              "verify"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^H[0-9]+$"
              },
              "scenario": {
                "type": "string"
              },
              "input": {
                "type": "string"
              },
              "expected": {
                "type": "string"
              },
              "level": {
                "type": "string"
              },
              "verify": {
                "type": "string"
              }
            }
          }
        },
        "edgeCases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "category",
              "severity",
              "scenario",
              "whyConcern",
              "assertion",
              "level",
              "verify",
              "focusFile"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^E[0-9]+$"
              },
              "category": {
                "type": "string"
              },
              "severity": {
                "type": "string"
              },
              "scenario": {
                "type": "string"
              },
              "whyConcern": {
                "type": "string"
              },
              "assertion": {
                "type": "string"
              },
              "level": {
                "type": "string"
              },
              "verify": {
                "type": "string"
              },
              "focusFile": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
