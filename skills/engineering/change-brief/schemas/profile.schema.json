{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "profile.schema.json",
  "title": "Domain profile (adapter vocabulary + heuristics)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "labels", "riskCategories", "severities",
    "testLevels", "verifyMethods", "edgeCategories", "tagRules"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "labels": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "riskCategories": { "type": "array", "items": { "type": "string" } },
    "severities": { "type": "array", "items": { "type": "string" } },
    "testLevels": { "type": "array", "items": { "type": "string" } },
    "verifyMethods": { "type": "array", "items": { "type": "string" } },
    "edgeCategories": { "type": "array", "items": { "type": "string" } },
    "tagRules": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    }
  }
}
